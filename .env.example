# ======================================
# Smart Factory IoT Platform — Environment Variables
# Copy this file to .env and fill in your values
# ======================================

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_factory
POSTGRES_USER=factory_admin
POSTGRES_PASSWORD=change_me_in_production

# ── Kafka ──
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_SENSOR=factory.sensor.raw
KAFKA_TOPIC_ALERTS=factory.alerts
KAFKA_GROUP_ID=smart-factory-consumer

# ── MQTT ──
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=factory/

# ── Spark ──
SPARK_MASTER=local[*]
SPARK_APP_NAME=SmartFactoryStreaming
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints

# ── Snowflake ──
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=SMART_FACTORY_DWH
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_ENABLED=false

# ── Airflow ──
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://factory_admin:change_me_in_production@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── FastAPI Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── React Frontend ──
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws/live

# ── Monitoring ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

# ── Docker Registry (CI/CD) ──
DOCKER_REGISTRY=ghcr.io
DOCKER_REPO=your-github-username/smart-factory-iot
